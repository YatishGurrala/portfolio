# The authoritative canonical URL for the portfolio.
# - Local development: uses the default localhost fallback (http://localhost:3000).
# - Vercel deployments: Vercel's stable production project URL (NEXT_PUBLIC_VERCEL_PROJECT_PRODUCTION_URL)
#   is automatically used as a fallback. No manual configuration is required.
# - Custom domain: when a custom portfolio domain is purchased and assigned, set NEXT_PUBLIC_SITE_URL
#   to that full domain (e.g., https://yourdomain.com). Do not set this to techbckp.com.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
